{
  "name": "lunar-landing-site-navigator",
  "version": "0.1.0",
  "private": true,
  "description": "Compare lunar landing sites and dates: Sun and Earth positions relative to the local horizon, for solar power and direct-to-Earth communication.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "build": "npm run typecheck && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "astronomy-engine": "2.1.19",
    "preact": "11.2.0"
  }
}
